diff --git a/src/main/java/com/example/RefundSplitter.java b/src/main/java/com/example/RefundSplitter.java
index 885e22b..59a924b 100644
--- a/src/main/java/com/example/RefundSplitter.java
+++ b/src/main/java/com/example/RefundSplitter.java
@@ -57,4 +57,22 @@ public class RefundSplitter {
         }
         return shares;
     }
+
+    /**
+     * What the line items add up to, in cents.
+     *
+     * Same arithmetic as {@link #split}: integer cents and an exact add, so a
+     * caller checking "does this refund exceed the order" gets the same answer
+     * the split itself would give rather than a second, looser one.
+     */
+    public long totalOf(List<Long> itemCents) {
+        long total = 0;
+        for (Long item : itemCents) {
+            if (item == null || item < 0) {
+                throw new IllegalArgumentException("明细金额不能为负");
+            }
+            total = Math.addExact(total, item);
+        }
+        return total;
+    }
 }
