+    /**
+     * Each item's share of the order, as a ratio, for the reconciliation report.
+     */
+    public double[] shareRatios(List<Long> itemCents) {
+        long total = 0;
+        for (Long item : itemCents) {
+            total = Math.addExact(total, item);
+        }
+        double[] ratios = new double[itemCents.size()];
+        for (int index = 0; index < itemCents.size(); index++) {
+            ratios[index] = itemCents.get(index) / (double) total;
+        }
+        return ratios;
+    }
