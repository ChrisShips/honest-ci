    "PlatformReview": {
      "description": "One review comment that was already on the change when this run started.\n\nA person -- or the platform's own assistant, which is why ``is_bot`` is\nrecorded rather than filtered -- has read this change and written something\ndown. That is evidence no gate produced and none can reproduce, so it\nenters as input: an unresolved thread is a question somebody asked and\nnobody answered, and merging past it automatically would be an automated\nverdict contradicting a human already on the record.\n\n``body`` is redacted and bounded in the model rather than in each adapter,\nbecause this is the one place text from outside the deployment enters the\ncontracts, and a credential pasted into a merge-request comment must not\nreach an artifact, a log or a model payload whichever platform it came from.",
      "properties": {
        "author": {
          "default": "",
          "title": "Author",
          "type": "string"
        },
        "body": {
          "default": "",
          "title": "Body",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "is_bot": {
          "default": false,
          "title": "Is Bot",
          "type": "boolean"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "resolved": {
