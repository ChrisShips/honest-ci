# Copy to .env and fill it in; .env is not committed.
# Every HONEST_CI_* is honest-ci's own setting; vendor credentials keep each vendor's
# official variable names.

# ── Model (off until a provider is named) ──────────────────────────────
# The model explains and helps a reviewer read; it never decides a verdict.
# Nothing is sent to any model until HONEST_CI_MODEL_PROVIDER names one: a key
# below on its own switches nothing on. Empty (the default) means no model calls.
# One of: deepseek | qwen | glm | openai | anthropic
HONEST_CI_MODEL_PROVIDER=
# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
HONEST_CI_DEEPSEEK_MODEL=deepseek-chat
# Qwen / Alibaba Cloud Model Studio (OpenAI-compatible)
DASHSCOPE_API_KEY=
HONEST_CI_QWEN_MODEL=qwen3.8-max
# Zhipu GLM / Z.ai
ZAI_API_KEY=
HONEST_CI_GLM_MODEL=glm-5.2
# OpenAI, or any OpenAI-compatible server: DeepSeek, a local Ollama, a gateway.
# OPENAI_API_KEY goes to whatever HONEST_CI_OPENAI_BASE_URL names; the vendor's own
# OPENAI_BASE_URL is deliberately not read.
# Local Ollama: base URL http://localhost:11434/v1, MAX_TOKENS_PARAM=max_tokens, and
# any non-empty OPENAI_API_KEY (Ollama ignores it, this product requires one).
OPENAI_API_KEY=
HONEST_CI_OPENAI_BASE_URL=https://api.openai.com/v1
HONEST_CI_OPENAI_MODEL=gpt-6-astra
# Reasoning counts against this cap, so it is sized for the thinking too.
HONEST_CI_OPENAI_MAX_TOKENS=16000
# OpenAI's reasoning models take only max_completion_tokens; Ollama and DeepSeek
# read max_tokens.
HONEST_CI_OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
# Empty sends no temperature, the only thing a reasoning model accepts.
HONEST_CI_OPENAI_TEMPERATURE=
HONEST_CI_OPENAI_TIMEOUT_SECONDS=300
# Anthropic (Messages API). The vendor's own ANTHROPIC_BASE_URL is deliberately not read.
ANTHROPIC_API_KEY=
HONEST_CI_ANTHROPIC_BASE_URL=https://api.anthropic.com
HONEST_CI_ANTHROPIC_MODEL=claude-opus-5
# Current Claude models think by default; this caps the thinking and the answer together.
HONEST_CI_ANTHROPIC_MAX_TOKENS=16000
# Empty sends no temperature: current Claude models reject it.
HONEST_CI_ANTHROPIC_TEMPERATURE=
HONEST_CI_ANTHROPIC_TIMEOUT_SECONDS=300
# Whether the model writes explanations: 1 = on (the default), 0 = off.
# Switched off, not a word of any gate's verdict changes (the model never decides one).
# What changes is that the explanation of why something was blocked and the reading aid
# for the human reviewer are no longer written, so the blocked lines aren't sent to the
# model for them either.
# Code that must not leave at all: keep HONEST_CI_MODEL_PROVIDER empty instead.
# This switch is for a deployment that enables a model but wants no explanations.
HONEST_CI_MODEL_EXPLAIN=1
# Whether the model judges the judgment rules (kind = "judgment"): 1 = on (the default),
# 0 = off.
# Kept apart from the one above because the two send out different things, with
# different risks: an explanation only restates a verdict already reached, while judging
# is the only way those rules get reviewed at all.
# Off is not skipped: judgment rules are recorded as not judged, the change goes to a
# person, and the evidence pack lists them under "What this run could not verify".
# Not asked is not the same as no problem.
HONEST_CI_MODEL_JUDGMENT=1
# Whether the model writes regression tests for this change: 1 = on (the default), 0 = off.
# Without an enabled provider and its key nothing is generated; no need to switch this off too.
# The generated tests are written into the sandbox tree, under tests/honest_ci_generated/
# (Python) or src/test/java/honest_ci/generated/ (Java), run on their own and deleted
# afterwards; their text stays in the artifacts. They are counted apart from the
# repository's own tests: passing them all raises no number, and a failure at most sends
# the change to a person and never blocks (the test may be wrong, or the code may be).
# Switched off, no model enabled, no key, a failed call, a proposal discarded at the trust
# boundary: each one is written into "What this run could not verify".
HONEST_CI_MODEL_TESTGEN=1
# How confident a model finding has to be to count among the findings (0–1, default 0.70).
# A doubt below the bar is still written under "What this run could not verify"; it just
# isn't a finding and stays out of the false-positive rate's denominator. Counting
# guesses the model itself isn't sure of would make that rate meaningless.
# A single rule can override it with min_confidence.
HONEST_CI_MODEL_MIN_CONFIDENCE=0.70

# ── Forge ──────────────────────────────────────────────────────────────
# github | local: the platform `honest-ci run-pr` talks to. local has no pull request to
# fetch; verify a local change with `honest-ci verify`.
HONEST_CI_FORGE=github
# In a workflow, pass the job's own token to the step (`secrets.GITHUB_TOKEN`); the job
# needs `contents: read`, `pull-requests: write` and `statuses: write`. The token only goes
# in request headers and git's environment: never in a URL, .git/config, the evidence pack
# or a log.
GITHUB_TOKEN=
# GitHub Enterprise Server: https://HOST/api/v3
HONEST_CI_GITHUB_BASE_URL=https://api.github.com
# The name of the commit status written back to the pull request: what a team's merge
# rules refer to
HONEST_CI_FORGE_STATUS_NAME=honest-ci/verify
HONEST_CI_FORGE_TIMEOUT_SECONDS=30

# ── License key ────────────────────────────────────────────────────────
# Needed only in CI, and only where one is due: on an organization's private or internal
# repository, and on a personal account's private one where other people open pull
# requests. In GitHub Actions that is after a 14-day trial, and the workflow passes the
# key from a secret as the Action's license-key input; in other CI systems, email
# support@honest-ci.dev for a trial key. The README's License section has the rest.
# The key is verified offline: it is sent nowhere, and no evidence pack or log has it.
# `honest-ci doctor` says whose a key is and until when.
HONEST_CI_LICENSE_KEY=

# ── Running the gates ──────────────────────────────────────────────────
# The team's rule library; the review gate makes its first pass against it. Without this
# file the review gate sends the change to a person rather than letting it through.
# For a production deployment, point it at a trusted path outside the repository;
# otherwise the change under verification can edit the rules in passing.
HONEST_CI_RULES_PATH=honest-ci-rules.toml
# Structural guardrails (sensitive paths, blast radius, required gates)
HONEST_CI_POLICY_PATH=honest-ci-policy.toml
# What an unavailable tool does: 1 = block (the default), 0 = record it and let the
# change through (local debugging only)
HONEST_CI_FAIL_CLOSED=1
# Which toolchain judges the change. auto (the default) goes by the build markers at the
# root of the workspace (pyproject.toml / requirements.txt … → python; pom.xml → java),
# and with no marker falls back to the first registered toolchain and says so in the
# evidence. python / java forces one. A mixed repository gets python by default, and the
# evidence says so. The scanners a tool rule in the rules file can name are the union of
# what the registered toolchains declare.
HONEST_CI_LANGUAGE=auto
# docker | process: how the tests and scans are isolated; never with a network
HONEST_CI_SANDBOX_MODE=docker
HONEST_CI_DOCKER_IMAGE=python:3.12-slim
# The image for Java with Maven; Gradle isn't supported yet. semgrep has to be
# preinstalled in the image.
HONEST_CI_JAVA_DOCKER_IMAGE=maven:3.9-eclipse-temurin-21
# An optional Maven mirror, with no credentials or query string. Only provisioning uses
# it; the offline scans don't.
HONEST_CI_MAVEN_MIRROR=
# Extra Maven coordinates to fetch during provisioning, comma-separated
# (groupId:artifactId:version, optionally followed by packaging and classifier). Some
# Maven artifacts are decided only when a goal runs: Surefire picks a provider for the
# test framework and brings its own JUnit Platform baseline, and the report plugin picks
# a skin when it renders. They are in no pom's dependency graph, go-offline can't fetch
# them, and an offline run stops at a download nobody declared.
# Their versions follow the surefire the repository under verification chose, which the
# toolchain can't guess, so they are written here; a deployment serving several
# repositories takes the union, and fetching extra does no harm. A missing one isn't
# mistaken for a problem in the code: a failed offline resolution is reported as tool
# unavailable (fail-closed blocks as usual), and names the missing coordinates as they are.
# For JUnit 5 + Surefire 3.5.2, the values are in examples/java-junit5/README.md.
HONEST_CI_MAVEN_EXTRA_ARTIFACTS=
# This machine's own Maven repository. A Java run in process mode (no Docker daemon, or
# HONEST_CI_SANDBOX_MODE=process) provisions nothing, so mvn -o also searches this one,
# after the workspace's .honest-ci/m2, and never writes to it (maven.repo.local.tail,
# Maven 3.9 or later; an older Maven ignores it, and what it can't resolve is blocked as
# usual). Your own builds fill it with the project's dependencies; the plugin versions
# the toolchain pins usually aren't there, and honest-ci doctor lists the missing ones
# with one line that fetches them. Name another absolute path if your settings.xml moves
# localRepository (the run reads no settings.xml of yours), or leave it empty to read
# none. Docker mode never reads it: the container can't see it. Nor does a
# HONEST_CI_TEST_COMMAND, which runs as written.
HONEST_CI_MAVEN_HOST_REPOSITORY=~/.m2/repository
HONEST_CI_COMMAND_TIMEOUT_SECONDS=300
# The provisioning timeout (seconds), kept apart from the one above. A scanner's timeout
# is set on the idea that a ruff run taking 5 minutes means something is wrong, while the
# first provisioning on a cold cache pulls down a whole toolchain: on a project with a
# single JUnit dependency, go-offline pulls more than 130 MB before it gets to resolving
# plugins. Cut it off on a scanner's scale and what you get isn't a slow scanner but
# every Java tool unavailable, and the whole repository blocked by fail-closed. A timeout
# exits with 124.
HONEST_CI_PROVISION_TIMEOUT_SECONDS=1800
# Gates switched off explicitly, comma-separated (for example regression). A gate
# switched off is recorded as skipped, which is not passed; if the policy's
# required_checks still requires it, the terminal state is still needs_human. Use it when
# the repository has no test suite yet, or when this run answers for the review gate
# only, rather than changing the code.
HONEST_CI_DISABLED_GATES=

# ── Regression gate ────────────────────────────────────────────────────
# The test command. Empty uses the default: python -m pytest -q, run through coverage run
# when either coverage threshold is > 0 and coverage is available; for Java, an offline
# Maven test, with JaCoCo prepare-agent / report added when either threshold is > 0.
# A command of your own runs as written (split with shlex, no shell), and never with a
# test selection added. If it is still pytest, its summary line is read; if not, it
# needs the JUnit XML below, or the exit code is all there is to read.
# For Python, coverage data has to come from the command itself, written where the
# COVERAGE_FILE the run sets points (a new file under the artifacts directory each run;
# coverage.py and pytest-cov both follow it). A .coverage an earlier run left is never
# read. A wrapper that filters the environment has to pass COVERAGE_FILE through.
HONEST_CI_TEST_COMMAND=
# The JUnit XML a custom test command leaves behind, as a glob relative to the workspace
# (reports/junit.xml, **/target/surefire-reports/*.xml). The gate reads the number of
# tests and the names of the failed ones from it, and clears old reports before the run.
# For Python it applies only to a custom command; for Java it defaults to
# **/target/surefire-reports/TEST-*.xml.
HONEST_CI_TEST_REPORT=
# The line coverage threshold (0–1). Below it blocks, and so does coverage that can't be
# measured: a threshold that is set has to be checkable.
# 0 switches the coverage check off explicitly, and the evidence pack says
# "not measured (the threshold is 0)".
HONEST_CI_COVERAGE_THRESHOLD=0.70
# The changed-line coverage threshold (0–1): of the executable lines this diff adds, the
# share the tests ran. 90% for the whole repository doesn't stop a new function nobody
# tests; this threshold does. Below it blocks, and the evidence pack lists the lines that
# didn't run.
# A changed file with no data in the coverage report blocks too: not checked is not the
# same as meeting the bar.
# 0 = recorded, not judged (the default): the evidence pack still shows the changed
# lines' coverage, but nothing blocks on it. Before turning this threshold on, look at
# your repository's real numbers.
HONEST_CI_CHANGED_LINE_COVERAGE_THRESHOLD=0
# Which tests run: all (the default, the whole suite) or impacted (only the tests impact
# analysis picks).
# When impacted picks no tests, the language has no impact analysis, or a file's symbols
# can't be read, it falls back to the whole suite: "0 tests picked, so it passed" is not
# a verdict. It also runs the whole suite while HONEST_CI_COVERAGE_THRESHOLD is above 0
# (that bar is a figure about the whole suite, which a narrowed run can't measure), so
# under the default 0.70 impacted narrows nothing; and with a HONEST_CI_TEST_COMMAND,
# which runs as written and can't take a selection. The changed-line bar does not stop
# it narrowing: fewer tests can only cover fewer changed lines, so a narrowed run never
# meets that bar more easily. The evidence pack says which one ran and why.
HONEST_CI_TEST_SELECTION=all
# The test suite's timeout (seconds), kept apart from the scanners'
# HONEST_CI_COMMAND_TIMEOUT_SECONDS: a test suite running 20 minutes is normal, a ruff
# run taking 5 minutes means something is wrong.
HONEST_CI_TEST_TIMEOUT_SECONDS=1800

# ── Runtime files ──────────────────────────────────────────────────────
HONEST_CI_LEDGER_PATH=.honest-ci/ledger.sqlite3
HONEST_CI_ARTIFACTS_DIR=.honest-ci/artifacts
